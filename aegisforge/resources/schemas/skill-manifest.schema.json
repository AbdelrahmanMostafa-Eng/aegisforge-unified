{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AbdelrahmanMostafa-Eng/aegisforge-unified/schemas/skill-manifest.schema.json",
  "title": "AegisForge Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "slug", "version", "status", "summary", "description",
    "domains", "capabilities", "skill_type", "keywords", "inputs", "outputs",
    "risk", "compatible_harnesses"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_][a-z0-9_.-]*$"},
    "name": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "status": {"enum": ["draft", "experimental", "stable", "deprecated", "archived"]},
    "summary": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "domains": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "skill_type": {"enum": ["method", "procedure", "workflow", "pattern", "reference", "template", "tool", "policy", "evaluator", "agent", "adapter"]},
    "keywords": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "inputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "outputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "confirmation"],
      "properties": {
        "level": {"enum": ["none", "low", "moderate", "high", "critical"]},
        "confirmation": {"type": "string", "minLength": 1}
      }
    },
    "compatible_harnesses": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "quality": {"type": "object"},
    "references": {"type": "array", "items": {"type": "string"}},
    "aliases": {"type": "array", "items": {"type": "string"}}
  }
}
